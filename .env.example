# Copia este archivo como .env y completa los valores.

# OpenAI: necesaria para /v1/sessions (agente) y para generar embeddings.
# /v1/recommend, /v1/crops y la búsqueda por palabras clave funcionan sin ella.
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.4-mini
CHAT_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Base de conocimiento generada por: uv run python -m ingestion.build_db
DB_PATH=data/knowledge.db

# Fuentes de la ingesta (relativas a esta carpeta)
STRUCTURED_DATA_DIR=knowledge/structured
PDF_DIR=knowledge/pdfs
WEB_DIR=knowledge/web
PROJECT_DOCS_DIR=knowledge/docs

# Memoria de corto plazo (InMemorySaver): exige 1 worker de uvicorn.
SESSION_TTL_MINUTES=120
SESSION_CLEANUP_INTERVAL_SECONDS=300
# Turnos de conversación que ve el modelo (el plot estructurado nunca se recorta).
MAX_CONVERSATION_TURNS=12

# RAG (BM25 + SQLiteVec combinados con EnsembleRetriever)
RAG_TOP_K=5
